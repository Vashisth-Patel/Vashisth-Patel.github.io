---
import Layout from '../layouts/LegacyLayout.astro';
import Navbar from '../components/legacy/Navbar.astro';
import Footer from '../components/legacy/Footer.astro';
import { withBase } from '../lib/url';

const CV_PDF = withBase('docs/Vashisth_Patel_CV.pdf');
---

<Layout title="Vashisth Patel | Résumé">
  <Navbar />

  <!-- Hero -->
  <section class="max-w-[1000px] mx-auto px-6 sm:px-12 pt-10 pb-8 sm:pt-14 sm:pb-10">
    <p class="font-mono text-green text-base sm:text-lg mb-3">Résumé</p>

    <h1 class="text-4xl sm:text-6xl font-bold text-lightest-slate tracking-tight">
      Vashisth Patel
    </h1>

    <h2 class="mt-3 text-xl sm:text-3xl font-bold text-slate tracking-tight max-w-3xl">
      Materials engineer working in operations and process improvement.
    </h2>

    <!-- Contact row -->
    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-sm text-slate">
      <span>Wiesbaden, Germany <span class="text-slate/60">(open to relocation)</span></span>
      <span class="text-lightest-navy hidden sm:inline">|</span>
      <a href="mailto:vashisth@vashisthpatel.com" class="hover:text-green transition-colors">vashisth@vashisthpatel.com</a>
      <span class="text-lightest-navy hidden sm:inline">|</span>
      <a href="https://linkedin.com/in/vashisth-patel" target="_blank" rel="noopener noreferrer" class="hover:text-green transition-colors">linkedin.com/in/vashisth-patel</a>
      <span class="text-lightest-navy hidden sm:inline">|</span>
      <a href="https://github.com/Vashisth-Patel" target="_blank" rel="noopener noreferrer" class="hover:text-green transition-colors">github.com/Vashisth-Patel</a>
    </div>

    <!-- CTA row -->
    <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        href="mailto:vashisth@vashisthpatel.com"
        class="inline-block px-8 py-4 border-2 border-green text-green font-mono text-sm rounded hover:bg-green/10 transition-all duration-300 hover:scale-105"
      >
        Email Me
      </a>
      <a
        href={CV_PDF}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-slate hover:text-green font-mono text-sm transition-colors duration-300"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download PDF
      </a>
    </div>
  </section>

  <!-- Highlights strip -->
  <section class="max-w-[1000px] mx-auto px-6 sm:px-12 pb-16">
    <div class="grid sm:grid-cols-3 gap-4">
      <div class="bg-light-navy border border-lightest-navy rounded-lg p-6">
        <p class="text-3xl sm:text-4xl font-bold text-green font-mono tracking-tight">1% → 30%</p>
        <p class="text-slate text-sm mt-2 leading-relaxed">Researcher-conversion rate rebuilt at Physics Mindboggler by fixing the root cause, not the outreach volume</p>
      </div>
      <div class="bg-light-navy border border-lightest-navy rounded-lg p-6">
        <p class="text-3xl sm:text-4xl font-bold text-green font-mono tracking-tight">23%</p>
        <p class="text-slate text-sm mt-2 leading-relaxed">System-utilization lift from a bottleneck analysis at a Mumbai laundry service</p>
      </div>
      <div class="bg-light-navy border border-lightest-navy rounded-lg p-6">
        <p class="text-2xl sm:text-3xl font-bold text-green font-mono tracking-tight">KUKA · RAGUSE</p>
        <p class="text-slate text-sm mt-2 leading-relaxed">Direct consulting exposure to hardware and medical-device manufacturing clients</p>
      </div>
    </div>
  </section>

  <!-- Summary -->
  <section class="max-w-[1000px] mx-auto px-6 sm:px-12 pb-20">
    <div class="max-w-3xl space-y-4">
      <p class="text-slate text-lg leading-relaxed">
        Materials engineer (B.Tech, IIT Gandhinagar) completing an MSc in Management at EBS Wiesbaden. Diagnoses operational problems on-site and builds the fix into a repeatable process.
      </p>
      <p class="text-slate text-lg leading-relaxed">
        Took researcher conversion at an early-stage platform from a <strong class="text-lightest-slate">1% to a 30% conversion rate</strong> by finding the actual cause of drop-off, then built the fix into a repeatable six-stage workflow with KPI tracking.
      </p>
      <p class="text-slate text-lg leading-relaxed">
        Client and field projects with <strong class="text-lightest-slate">KUKA Robotics</strong> (market entry strategy), a German medical-device manufacturer (circular supply chain design), and a Mumbai laundry operation (bottleneck analysis, 23% utilisation gain). Each produced analysis and recommendations.
      </p>
      <p class="text-slate text-lg leading-relaxed">
        Finishing the MSc in June 2027. Looking for an internship or working student role in operations, process improvement, or project management. Based in Wiesbaden, open to relocation.
      </p>
    </div>
  </section>

  <!-- 01. Professional Experience -->
  <section class="max-w-[1000px] mx-auto px-6 sm:px-12 py-16">
    <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 mb-8 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold text-lightest-slate font-mono">
        <span class="text-green">01.</span> Professional Experience
      </h2>
      <div class="h-[1px] bg-lightest-navy w-full max-w-xs"></div>
    </div>

    <div class="group bg-light-navy p-6 rounded-lg border border-lightest-navy hover:border-green hover:-translate-y-1 transition-all duration-300">
      <h3 class="text-xl font-semibold text-lightest-slate mb-1">
        Operations &amp; Process — Researcher Acquisition
      </h3>
      <p class="text-slate text-sm mb-1">
        Physics Mindboggler | Remote, Working Student. Early-stage platform connecting industrial R&amp;D projects with domain experts.
      </p>
      <p class="text-green text-xs font-mono mb-4">Feb — Jun 2025</p>

      <div class="space-y-3 text-slate mb-4">
        <div class="flex gap-3">
          <span class="text-green mt-1">▹</span>
          <span>Diagnosed a <strong class="text-lightest-slate">1% researcher-conversion rate</strong> by following up repeatedly with previously non-responding or slow-to-reply researchers and asking why; identified a trust deficit as the root cause driving onboarding failure.</span>
        </div>
        <div class="flex gap-3">
          <span class="text-green mt-1">▹</span>
          <span>Redesigned outreach from cold email to personalized LinkedIn engagement, moving conversion <strong class="text-lightest-slate">from 1% to 30%</strong> by fixing the root cause directly, not by scaling volume.</span>
        </div>
        <div class="flex gap-3">
          <span class="text-green mt-1">▹</span>
          <span>Systematized the approach into a 6-stage repeatable workflow with KPI dashboards tracking conversion rate, funnel progression, and response rates.</span>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <span class="text-xs font-mono text-green bg-green/10 px-3 py-1 rounded border border-green/30">1% → 30% Conversion</span>
        <span class="text-xs font-mono text-green bg-green/10 px-3 py-1 rounded border border-green/30">6-Stage KPI Workflow</span>
      </div>
    </div>
  </section>

  <!-- 02. Projects -->
  <section class="max-w-[1000px] mx-auto px-6 sm:px-12 py-16">
    <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 mb-8 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold text-lightest-slate font-mono">
        <span class="text-green">02.</span> Projects
      </h2>
      <div class="h-[1px] bg-lightest-navy w-full max-w-xs"></div>
    </div>

    <div class="space-y-6">
      <!-- Sales Operations Pipeline -->
      <div class="group bg-light-navy p-6 rounded-lg border border-lightest-navy hover:border-green hover:-translate-y-1 transition-all duration-300">
        <h3 class="text-xl font-semibold text-lightest-slate mb-1">
          Sales Operations — Industrial B2B Lead Pipeline
        </h3>
        <p class="text-slate text-sm mb-1">Independent Project</p>
        <p class="text-green text-xs font-mono mb-4">2026</p>

        <div class="space-y-3 text-slate mb-4">
          <div class="flex gap-3">
            <span class="text-green mt-1">▹</span>
            <span>HubSpot pipeline for a simulated industrial-inspection-equipment sales motion: custom deal stages, properties, data-hygiene rules built to survive scale.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-green mt-1">▹</span>
            <span>n8n workflow (deployed on Render, backed by NeonDB) enriching inbound leads with firmographic data via the Gemini API, scoring each against a documented, auditable ICP.</span>
          </div>
          <div class="flex gap-3">
            <span class="text-green mt-1">▹</span>
            <span>Reporting layer on top: pipeline by stage, conversion by segment, lead-source performance.</span>
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">HubSpot</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">n8n</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Render</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">NeonDB</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Gemini API</span>
        </div>
      </div>

      <!-- AI-Powered VC Qualification Engine -->
      <div class="group bg-light-navy p-6 rounded-lg border border-lightest-navy hover:border-green hover:-translate-y-1 transition-all duration-300">
        <h3 class="text-xl font-semibold text-lightest-slate mb-1">
          AI-Powered VC Qualification Engine
        </h3>
        <p class="text-slate text-sm mb-4">Stack: n8n, NeonDB, Render, Antigravity, open-source LLM</p>

        <div class="space-y-3 text-slate mb-4">
          <div class="flex gap-3">
            <span class="text-green mt-1">▹</span>
            <span>End-to-end prototype automating first-pass startup screening for a VC firm: n8n workflow backend with regulatory-compliance comparison, benchmarking against 100+ stored companies, auto-generated scoring dashboard.</span>
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">n8n</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">NeonDB</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Render</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Antigravity</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Open-source LLM</span>
        </div>
      </div>

      <!-- Fraunhofer IPT Hackathon -->
      <div class="group bg-light-navy p-6 rounded-lg border border-lightest-navy hover:border-green hover:-translate-y-1 transition-all duration-300">
        <h3 class="text-xl font-semibold text-lightest-slate mb-1">
          Fraunhofer IPT Hackathon, Aachen
        </h3>
        <p class="text-green text-xs font-mono mb-4">Jul 2025</p>

        <div class="space-y-3 text-slate mb-4">
          <div class="flex gap-3">
            <span class="text-green mt-1">▹</span>
            <span>Python/Arduino safety-system prototype built in a 24-hour window, working alongside MTU Aero Engines; awarded Outstanding Performance.</span>
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          <span class="text-xs font-mono text-green bg-green/10 px-3 py-1 rounded border border-green/30">Outstanding Performance</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Python + Arduino</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">24-Hour Build</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 03. Consulting & Field Projects -->
  <section class="max-w-[1000px] mx-auto px-6 sm:px-12 py-16">
    <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 mb-8 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold text-lightest-slate font-mono">
        <span class="text-green">03.</span> Consulting &amp; Field Projects
      </h2>
      <div class="h-[1px] bg-lightest-navy w-full max-w-xs"></div>
    </div>

    <div class="space-y-6">
      <!-- KUKA -->
      <div class="group bg-light-navy p-6 rounded-lg border border-lightest-navy hover:border-green hover:-translate-y-1 transition-all duration-300">
        <div class="flex items-start justify-between gap-3 mb-1 flex-wrap">
          <h3 class="text-xl font-semibold text-lightest-slate">KUKA Robotics, Germany</h3>
          <span class="text-xs font-mono text-green bg-green/10 px-3 py-1 rounded border border-green/30">Hardware Client</span>
        </div>
        <p class="text-slate text-sm mb-4">Market Entry Strategy | Team of 5</p>
        <p class="text-slate leading-relaxed">
          Market-entry strategy for an underpenetrated SME-manufacturer segment. Benchmarked ABB, Fanuc, and Universal Robots, conducted primary research with industry leaders and system integrators, and designed a three-layer platform architecture spanning hardware, digital twin workflow, and customer-facing interface.
        </p>
      </div>

      <!-- RAGUSE -->
      <div class="group bg-light-navy p-6 rounded-lg border border-lightest-navy hover:border-green hover:-translate-y-1 transition-all duration-300">
        <div class="flex items-start justify-between gap-3 mb-1 flex-wrap">
          <h3 class="text-xl font-semibold text-lightest-slate">RAGUSE, Germany</h3>
          <span class="text-xs font-mono text-green bg-green/10 px-3 py-1 rounded border border-green/30">Hardware Client</span>
        </div>
        <p class="text-slate text-sm mb-4">Medical-Device Manufacturer · Circular Supply Chain Design | Team of 6</p>
        <p class="text-slate leading-relaxed">
          RFID-enabled waste-tracking system and circular supply chain for surgical drapes across 3 production sites, modelling <strong class="text-lightest-slate">90% collection</strong> and <strong class="text-lightest-slate">75% recycling yield</strong> targets, with breakeven analysis and a 6-month pilot roadmap presented to client leadership.
        </p>
      </div>

      <!-- Laundry -->
      <div class="group bg-light-navy p-6 rounded-lg border border-lightest-navy hover:border-green hover:-translate-y-1 transition-all duration-300">
        <h3 class="text-xl font-semibold text-lightest-slate mb-1">Local Laundry Service, Mumbai</h3>
        <p class="text-slate text-sm mb-4">Bottleneck Analysis</p>
        <p class="text-slate leading-relaxed">
          On-site time-and-motion analysis identifying ironing and air-drying as primary bottlenecks. Recommended process interventions improving system utilisation by <strong class="text-lightest-slate">23%</strong>.
        </p>
      </div>
    </div>
  </section>

  <!-- 04. Education -->
  <section class="max-w-[1000px] mx-auto px-6 sm:px-12 py-16">
    <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 mb-8 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold text-lightest-slate font-mono">
        <span class="text-green">04.</span> Education
      </h2>
      <div class="h-[1px] bg-lightest-navy w-full max-w-xs"></div>
    </div>

    <div class="divide-y divide-lightest-navy border border-lightest-navy rounded-lg bg-light-navy overflow-hidden">
      <div class="p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="text-lg font-semibold text-lightest-slate">MSc Management</h3>
          <span class="text-green text-xs font-mono whitespace-nowrap">Aug 2024 — Jun 2027 (expected)</span>
        </div>
        <p class="text-slate text-sm mt-1">EBS University for Business and Law, Germany</p>
        <p class="text-slate text-sm mt-2 leading-relaxed">
          Thesis: <span class="text-lightest-slate">Business Model Innovation in Technology-Driven Firms</span> (Amit &amp; Zott's Activity System Framework)
        </p>
      </div>
      <div class="p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="text-lg font-semibold text-lightest-slate">Global Management Programme</h3>
          <span class="text-green text-xs font-mono whitespace-nowrap">Dec 2023 — Jun 2024</span>
        </div>
        <p class="text-slate text-sm mt-1">SP Jain Institute of Management &amp; Research, Mumbai</p>
        <p class="text-slate text-sm mt-2 leading-relaxed">GPA <span class="text-lightest-slate">3.4/4</span>, ranked top 2 of cohort</p>
      </div>
      <div class="p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="text-lg font-semibold text-lightest-slate">B.Tech, Materials Science &amp; Engineering</h3>
          <span class="text-green text-xs font-mono whitespace-nowrap">Aug 2019 — Jun 2023</span>
        </div>
        <p class="text-slate text-sm mt-1">IIT Gandhinagar</p>
        <p class="text-slate text-sm mt-2 leading-relaxed">Undergraduate research: electrokinetic energy harvesting</p>
      </div>
    </div>
  </section>

  <!-- 05. Skills -->
  <section class="max-w-[1000px] mx-auto px-6 sm:px-12 py-16">
    <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 mb-8 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold text-lightest-slate font-mono">
        <span class="text-green">05.</span> Skills
      </h2>
      <div class="h-[1px] bg-lightest-navy w-full max-w-xs"></div>
    </div>

    <div class="grid sm:grid-cols-2 gap-8">
      <div>
        <h3 class="text-green font-mono text-[13px] mb-3 uppercase tracking-widest">Tools</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Excel (advanced)</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Power BI</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">SQL</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Python</span>
        </div>
      </div>
      <div>
        <h3 class="text-green font-mono text-[13px] mb-3 uppercase tracking-widest">AI &amp; Automation</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">n8n</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Gemini API</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Google Cloud Console</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">LLM Workflow Integration</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">HubSpot</span>
        </div>
      </div>
      <div>
        <h3 class="text-green font-mono text-[13px] mb-3 uppercase tracking-widest">Infrastructure</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Render</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">NeonDB</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Cloudflare</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Hostinger</span>
        </div>
      </div>
      <div>
        <h3 class="text-green font-mono text-[13px] mb-3 uppercase tracking-widest">Languages</h3>
        <div class="flex flex-wrap gap-2">
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">English (C1)</span>
          <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">German (B1)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 06. Certifications & Awards -->
  <section class="max-w-[1000px] mx-auto px-6 sm:px-12 py-16">
    <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 mb-8 sm:mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold text-lightest-slate font-mono">
        <span class="text-green">06.</span> Certifications &amp; Awards
      </h2>
      <div class="h-[1px] bg-lightest-navy w-full max-w-xs"></div>
    </div>

    <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3">
      <li class="flex gap-3 text-slate text-sm leading-relaxed">
        <span class="text-green mt-1 shrink-0">▹</span>
        <span>PM Certification (24 PDUs), SPJIMR (PMI-authorised partner) <span class="text-slate/60">· 2024</span></span>
      </li>
      <li class="flex gap-3 text-slate text-sm leading-relaxed">
        <span class="text-green mt-1 shrink-0">▹</span>
        <span>Management Consulting Specialization, Emory University <span class="text-slate/60">· 2024</span></span>
      </li>
      <li class="flex gap-3 text-slate text-sm leading-relaxed">
        <span class="text-green mt-1 shrink-0">▹</span>
        <span>Fundamental Business Certifications, Harvard Business Publishing <span class="text-slate/60">· 2024</span></span>
      </li>
      <li class="flex gap-3 text-slate text-sm leading-relaxed">
        <span class="text-green mt-1 shrink-0">▹</span>
        <span>SP Jain Dean's Honor List <span class="text-slate/60">· 2024</span></span>
      </li>
      <li class="flex gap-3 text-slate text-sm leading-relaxed">
        <span class="text-green mt-1 shrink-0">▹</span>
        <span>CAT 98.3 percentile (Quant 99.7 percentile), top 2% nationally, India</span>
      </li>
      <li class="flex gap-3 text-slate text-sm leading-relaxed">
        <span class="text-green mt-1 shrink-0">▹</span>
        <span>Outstanding Performance Certificate, Fraunhofer IPT Hackathon with MTU Aero Engines <span class="text-slate/60">· 2025</span></span>
      </li>
      <li class="flex gap-3 text-slate text-sm leading-relaxed">
        <span class="text-green mt-1 shrink-0">▹</span>
        <span>2nd place, EBS Quantathon <span class="text-slate/60">· 2026</span></span>
      </li>
    </ul>
  </section>

  <!-- Contact CTA -->
  <section class="max-w-[600px] mx-auto px-6 sm:px-12 py-24 text-center">
    <p class="font-mono text-green text-base mb-4">Contact</p>
