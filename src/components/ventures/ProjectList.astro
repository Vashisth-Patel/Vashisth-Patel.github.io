---
/**
 * The plain list view: every project, no story, in chapter order.
 * Target of "Skip the story, show all projects" (#all-projects). Built for screen readers
 * and recruiters who want the facts first.
 */
import { allProjects, pad } from '../../data/ventures';

const tagFor = (k: string) => (k === 'field' ? 'Field project' : k === 'role' ? 'Working student role' : null);
---

<section id="all-projects" class="ledger" aria-labelledby="ledger-title" data-vx-ledger>
  <div class="container">
    <header class="ledger__head">
      <p class="eyebrow ledger__eyebrow" data-reveal>Appendix</p>
      <h2 id="ledger-title" class="ledger__title" data-reveal style="--delay:60ms">All projects</h2>
      <p class="ledger__intro" data-reveal style="--delay:120ms">
        The same {allProjects.length} projects without the story, in chapter order.
      </p>
    </header>

    <ol class="ledger__list">
      {allProjects.map((p) => {
        const tag = tagFor(p.kind);
        return (
          <li class="ledger__row">
            <a
              class="ledger__ch"
              href={`#ch-${p.chapter}`}
              aria-label={`Chapter ${p.chapter}: ${p.chapterTitle}`}
              title={`Chapter ${p.chapter}: ${p.chapterTitle}`}
            >
              {pad(p.chapter)}
            </a>
            <div class="ledger__main">
              <h3 class="ledger__name">
                {p.title}
                {tag && <span class="ledger__tag">{tag}</span>}
              </h3>
              <p class="ledger__short">{p.short}</p>
            </div>
            <p class="ledger__meta">
              <span>{p.context}</span>
              {p.team && <span class="ledger__team">{p.team}</span>}
            </p>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .ledger {
    padding: clamp(80px, 12vh, 140px) 0 clamp(56px, 8vh, 96px);
    border-top: 1px solid var(--fg);
    background: color-mix(in srgb, var(--paper-2) 55%, var(--bg));
    scroll-margin-top: 40px;
  }

  .ledger__head { margin-bottom: clamp(28px, 4vh, 44px); }
  .ledger__eyebrow { color: var(--accent); }
  .ledger__title {
    font-family: var(--font-report);
    font-weight: 380;
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1;
    letter-spacing: -0.025em;
    margin-top: 10px;
  }
  .ledger__intro {
    margin-top: 14px;
    color: var(--muted);
    font-size: 16px;
  }

  .ledger__list {
    list-style: none;
    padding: 0;
    border-top: 2px solid var(--fg);
  }

  .ledger__row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 6px 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hair);
  }
  @media (min-width: 900px) {
    .ledger__row {
      grid-template-columns: 56px minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 0 32px;
      padding: 18px 0;
    }
  }

  .ledger__ch {
    font-family: var(--font-report);
    font-size: 18px;
    line-height: 1.3;
    color: var(--accent);
    text-decoration: none;
    font-variant-numeric: lining-nums tabular-nums;
    align-self: start;
  }
  .ledger__ch:hover { text-decoration: underline; text-underline-offset: 3px; }

  .ledger__name {
    font-family: var(--font-report);
    font-weight: 450;
    font-size: 18.5px;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .ledger__tag {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 8px;
    vertical-align: 2px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 999px;
    white-space: nowrap;
  }
  .ledger__short {
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.5;
  }

  .ledger__meta {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .ledger__meta { grid-column: 3; padding-top: 3px; }
  }
  .ledger__meta > span:first-child {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
  }
</style>
