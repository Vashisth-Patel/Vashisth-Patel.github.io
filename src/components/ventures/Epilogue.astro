---
/**
 * Epilogue: the nova fades (outline mark), the statement, contact, and the way out
 * to the other worlds (data-warp links play the transition from scripts/warp.ts).
 */
import NovaMark from './NovaMark.astro';
import { site, worlds } from '../../data/site';
import { withBase } from '../../lib/url';

const others = worlds.filter((w) => w.id !== 'ventures');
---

<section class="epi" aria-labelledby="epi-title">
  <div class="container epi__inner">
    <p class="eyebrow epi__eyebrow" data-reveal>Epilogue</p>

    <div class="epi__mark" data-reveal style="--delay:60ms"><NovaMark variant="outline" /></div>

    <h2 id="epi-title" class="epi__title" data-reveal style="--delay:120ms">
      <span>Nova doesn’t exist.</span>
      <span class="epi__accent">The work does.</span>
    </h2>

    <div class="epi__rule" data-vx-line style="--delay:200ms"></div>

    <div class="epi__grid">
      <div class="epi__contact" data-reveal style="--delay:260ms">
        <p class="epi__lede">
          Based in {site.location.split(',')[0]}. Looking for a mandatory internship or working student
          role in operations, process improvement or project management.
        </p>
        <ul class="epi__links">
          <li>
            <a class="epi__mail" href={`mailto:${site.email}`} data-vx-contact="email">{site.email}</a>
          </li>
          <li>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer" data-vx-contact="linkedin">
              LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
        </ul>
      </div>

      <nav class="epi__worlds" aria-label="Other worlds" data-reveal style="--delay:320ms">
        <p class="epi__label">Elsewhere on this site</p>
        <ul>
          {others.map((w) => (
            <li>
              <a href={withBase(w.path)} data-warp>
                <span class="epi__wname">{w.name}</span>
                <span class="epi__wtag">{w.tagline}</span>
                <span class="epi__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
          <li>
            <a href={withBase('')} data-warp>
              <span class="epi__wname">Back to orbit</span>
              <span class="epi__wtag">home</span>
              <span class="epi__arrow" aria-hidden="true">↺</span>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <footer class="container epi__colophon">
    <p>Nova is fictional. The projects, numbers and teammates are real. Quotes checked against their original sources.</p>
    <p>© {new Date().getFullYear()} {site.name}</p>
  </footer>
</section>

<style>
  .epi {
    padding: clamp(96px, 16vh, 180px) 0 0;
    border-top: 1px solid var(--fg);
  }

  .epi__eyebrow { color: var(--accent); }

  .epi__mark {
    width: clamp(56px, 7vw, 84px);
    aspect-ratio: 1;
    margin: clamp(28px, 5vh, 48px) 0 clamp(20px, 3vh, 32px);
    color: var(--muted);
  }
  .epi__mark :global(.nova) { width: 100%; height: 100%; color: var(--muted); }

  .epi__title {
    font-family: var(--font-report);
    font-weight: 320;
    font-size: clamp(44px, 8vw, 116px);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variation-settings: 'opsz' 144;
  }
  .epi__title > span { display: block; }
  .epi__accent { font-style: italic; color: var(--accent); }

  .epi__rule {
    height: 1px;
    background: var(--fg);
    margin: clamp(36px, 6vh, 64px) 0 clamp(28px, 4vh, 44px);
  }

  .epi__grid {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 860px) {
    .epi__grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(48px, 7vw, 112px); }
  }

  .epi__lede {
    font-size: clamp(17px, 1.5vw, 19px);
    line-height: 1.6;
    max-width: 44ch;
    text-wrap: pretty;
  }

  .epi__links {
    list-style: none;
    padding: 0;
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 28px;
  }
  .epi__links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 500;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    text-decoration-color: var(--hair);
    transition: color 0.2s, text-decoration-color 0.2s;
  }
  .epi__links a:hover { color: var(--accent); text-decoration-color: currentColor; }
  .epi__mail {
    font-family: var(--font-report);
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 400 !important;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .epi__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .epi__worlds ul { list-style: none; padding: 0; border-top: 1px solid var(--hair); }
  .epi__worlds a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--hair);
    color: var(--fg);
    text-decoration: none;
  }
  .epi__wname {
    font-family: var(--font-report);
    font-size: 22px;
    letter-spacing: -0.01em;
  }
  .epi__wtag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .epi__arrow { transition: transform 0.3s var(--ease-out), color 0.2s; }
  .epi__worlds a:hover .epi__wname,
  .epi__worlds a:hover .epi__arrow { color: var(--accent); }
  .epi__worlds a:hover .epi__arrow { transform: translateX(4px); }

  .epi__colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(80px, 14vh, 144px);
    padding: 20px 0 max(28px, env(safe-area-inset-bottom));
    border-top: 1px solid var(--hair);
    font-size: 12.5px;
    color: var(--muted);
  }
</style>
