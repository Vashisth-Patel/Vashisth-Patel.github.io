---
/**
 * Story progress.
 * - Desktop (>= 1100px): a sticky vertical rail listing the nine chapters; the active one is
 *   set by scripts/ventures/story.ts (IntersectionObserver) via aria-current="location".
 * - Below 1100px: a 2px progress line at the top of the viewport plus a small chapter chip.
 */
import { chapters, pad } from '../../data/ventures';
---

<aside class="rail-wrap">
  <nav class="rail" aria-label="Chapters">
    <p class="rail__label">Nova, in nine stages</p>
    <div class="rail__body">
      <div class="rail__track" aria-hidden="true"><span class="rail__fill" data-vx-fill="y"></span></div>
      <ol class="rail__list">
        {chapters.map((c) => (
          <li>
            <a href={`#ch-${c.n}`} data-vx-rail={c.n}>
              <span class="rail__n">{pad(c.n)}</span>
              <span class="rail__t">{c.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
    <a class="rail__all" href="#all-projects" data-vx-listview>All projects <span aria-hidden="true">↓</span></a>
  </nav>
</aside>

<div class="vx-bar" data-vx-bar aria-hidden="true">
  <div class="vx-bar__line"><span class="vx-bar__fill" data-vx-fill="x"></span></div>
  <div class="vx-bar__chip">
    <span class="vx-bar__n" data-vx-bar-n>01</span>
    <span class="vx-bar__of">/ {pad(chapters.length)}</span>
    <span class="vx-bar__t" data-vx-bar-t>{chapters[0].title}</span>
  </div>
</div>

<style>
  /* ---------- Desktop rail ---------- */
  .rail-wrap { display: none; }

  @media (min-width: 1100px) {
    .rail-wrap { display: block; }
    .rail {
      position: sticky;
      top: 104px;
      padding-top: clamp(56px, 9vh, 104px);
    }
  }

  .rail__label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 18px;
  }

  .rail__body { position: relative; padding-left: 18px; }
  .rail__track {
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--hair);
  }
  .rail__fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
  }

  .rail__list { list-style: none; padding: 0; }
  .rail__list a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 6px 0;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.3s var(--ease-out);
  }
  .rail__list a::before {
    content: '';
    position: absolute;
    left: -21px;
    top: 50%;
    width: 7px;
    height: 7px;
    margin-top: -3.5px;
    border-radius: 50%;
    background: var(--accent);
    transform: scale(0);
    transition: transform 0.35s var(--ease-out);
  }
  .rail__n {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    transition: color 0.3s var(--ease-out);
  }
  .rail__t {
    font-size: 13.5px;
    line-height: 1.35;
    transition: transform 0.35s var(--ease-out);
  }
  .rail__list a:hover { color: var(--fg); }
  .rail__list a[aria-current] { color: var(--fg); }
  .rail__list a[aria-current]::before { transform: scale(1); }
  .rail__list a[aria-current] .rail__n { color: var(--accent); }
  .rail__list a[aria-current] .rail__t { font-weight: 600; transform: translateX(2px); }

  .rail__all {
    display: inline-flex;
    gap: 6px;
    margin-top: 22px;
    padding-top: 14px;
    border-top: 1px solid var(--hair);
    font-size: 13px;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
  }
  .rail__all:hover { color: var(--accent); }

  /* ---------- Compact bar (below 1100px) ---------- */
  .vx-bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 60;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }
  .vx-bar.is-on { opacity: 1; }
  @media (min-width: 1100px) {
    .vx-bar { display: none; }
  }

  .vx-bar__line {
    height: 2px;
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .vx-bar__fill {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .vx-bar__chip {
    position: absolute;
    top: calc(max(10px, env(safe-area-inset-top)) + 50px);
    left: var(--gutter);
    display: flex;
    align-items: baseline;
    gap: 6px;
    max-width: calc(100vw - 2 * var(--gutter));
    padding: 5px 12px;
    border: 1px solid var(--hair);
    border-radius: 999px;
    background: var(--nav-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 12px;
    white-space: nowrap;
    translate: 0 -4px;
    transition: translate 0.35s var(--ease-out);
  }
  .vx-bar.is-on .vx-bar__chip { translate: 0 0; }
  .vx-bar__n {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .vx-bar__of {
    font-family: var(--font-mono);
    color: var(--muted);
  }
  .vx-bar__t {
    overflow: hidden;
    text-overflow: ellipsis;
    margin-left: 4px;
  }
</style>
