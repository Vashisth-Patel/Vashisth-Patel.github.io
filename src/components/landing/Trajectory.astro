---
/** Short education + work timeline, drawn as two orbital tracks. */
import { education, work, type Stop } from '../../data/landing';

const tracks: { id: string; title: string; stops: Stop[] }[] = [
  { id: 'edu', title: 'Education', stops: education },
  { id: 'work', title: 'Work & recognition', stops: work },
];
---

<section class="trajectory" id="trajectory" aria-labelledby="traj-title">
  <div class="container">
    <header data-reveal>
      <p class="eyebrow">Trajectory</p>
      <h2 id="traj-title">So far.</h2>
    </header>

    <div class="tracks">
      {tracks.map((t) => (
        <div class="track">
          <h3 class="track-title" data-reveal>{t.title}</h3>
          <ol>
            {t.stops.map((s, i) => (
              <li class:list={['stop', { now: s.now }]} data-reveal style={`--delay:${i * 90}ms`}>
                <span class="node" aria-hidden="true"></span>
                <p class="when">
                  {s.when}
                  {s.now && <span class="tag">now</span>}
                </p>
                <p class="title">{s.title}</p>
                <p class="place">{s.place}</p>
                {s.note && <p class="note">{s.note}</p>}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trajectory { position: relative; padding-block: clamp(72px, 12vw, 150px); }
  h2 {
    margin-top: 12px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 6.5vw, 96px);
    line-height: 1;
  }
  .tracks {
    margin-top: clamp(32px, 5vw, 60px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 5vw, 80px);
  }
  .track-title {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 16px;
    border-bottom: 1px solid var(--hair);
  }
  ol { list-style: none; padding: 0; position: relative; }
  ol::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 28px;
    bottom: 22px;
    width: 1px;
    background: linear-gradient(to bottom, rgba(244, 241, 234, 0.35), rgba(244, 241, 234, 0.08));
  }
  .stop { position: relative; padding: 22px 0 6px 32px; }
  .node {
    position: absolute;
    left: 0;
    top: 28px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid rgba(244, 241, 234, 0.7);
    background: var(--space-0);
  }
  .now .node {
    background: #fff;
    border-color: #fff;
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.5);
    animation: ping 2.4s ease-out infinite;
  }
  @keyframes ping {
    0% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.45); }
    80%, 100% { box-shadow: 0 0 0 12px rgba(255, 255, 255, 0); }
  }
  .when {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: rgba(244, 241, 234, 0.6);
  }
  .tag {
    padding: 1px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .title { margin-top: 6px; font-size: 18px; font-weight: 600; line-height: 1.35; color: var(--starlight); }
  .place { margin-top: 2px; font-size: 15px; color: rgba(244, 241, 234, 0.72); }
  .note { margin-top: 6px; font-size: 14.5px; line-height: 1.55; color: var(--muted); max-width: 44ch; }

  @media (max-width: 820px) {
    .tracks { grid-template-columns: 1fr; }
  }
</style>
