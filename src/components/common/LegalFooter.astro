---
/**
 * Small legal line (Impressum + privacy notice) at the end of every page that has no footer of
 * its own. German law expects both to be reachable from every page.
 */
import { withBase } from '../../lib/url';
import { site } from '../../data/site';
---

<footer class="legal-footer">
  <span>© {new Date().getFullYear()} {site.name}</span>
  <span aria-hidden="true">·</span>
  <a href={withBase('impressum/')}>Impressum</a>
  <span aria-hidden="true">·</span>
  <a href={withBase('datenschutz/')}>Privacy</a>
</footer>

<style>
  .legal-footer {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 10px;
    padding: 20px var(--gutter) max(20px, env(safe-area-inset-bottom));
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .legal-footer a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--hair); }
  .legal-footer a:hover { color: var(--fg); border-color: var(--fg); }
</style>
