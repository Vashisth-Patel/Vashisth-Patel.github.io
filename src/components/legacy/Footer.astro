---
// Footer component with copyright, legal links and design attribution
import { withBase } from '../../lib/url';
---

<footer class="mt-20 pb-10 flex justify-between items-end px-6 sm:px-12 max-w-[1600px] mx-auto border-t border-lightest-navy pt-6">
  <div class="text-xs text-slate/50">
    © 2026 Vashisth Patel. All rights reserved.
    <span class="mx-1">·</span><a href={withBase('impressum/')} class="hover:text-green transition-colors">Impressum</a>
    <span class="mx-1">·</span><a href={withBase('datenschutz/')} class="hover:text-green transition-colors">Privacy</a>
  </div>
  <div class="text-right">
    <p class="text-xs font-mono text-slate/60">
      Inspired by <a href="https://brittanychiang.com" target="_blank" rel="noopener noreferrer" class="hover:text-green transition-colors">Brittany Chiang</a>
    </p>
  </div>
</footer>
