---
import { withBase } from '../../lib/url';
// Built — Section 04
---

<section id="built" class="max-w-[1000px] mx-auto px-6 sm:px-12 py-24">
  <!-- Section Heading -->
  <div class="flex items-center gap-4 mb-12">
    <h2 class="text-3xl font-bold text-lightest-slate font-mono whitespace-nowrap">
      <span class="text-green">04.</span> Built
    </h2>
    <div class="h-[1px] bg-lightest-navy w-full max-w-xs"></div>
  </div>

  <!-- Intro text -->
  <p class="text-slate text-lg leading-relaxed mb-10 max-w-2xl">
    Tooling built to solve specific problems, outside coursework and client work.
  </p>

  <!-- Project Card: FinTech Partner Qualification Engine -->
  <div class="group bg-light-navy p-6 rounded-lg border border-lightest-navy hover:border-green hover:-translate-y-1 transition-all duration-300">
    <div class="flex items-start justify-between mb-4">
      <div class="flex-1">
        <div class="flex items-center gap-3 mb-2 flex-wrap">
          <h3 class="text-xl font-semibold text-lightest-slate">
            AI-Powered VC Qualification Engine
          </h3>
          <span class="px-3 py-1 bg-green/20 text-green text-xs font-mono rounded border border-green">
            Live Project
          </span>
        </div>

        <!-- Description -->
        <p class="text-slate text-sm leading-relaxed mb-3">
          First-pass startup screening for a VC firm — hybrid AI and regulatory-compliance logic instead of manual review.
        </p>
        <p class="text-slate text-sm leading-relaxed mb-5">
          The problem: VC firms spend manual time screening startup leads against regulatory requirements and internal benchmarks. Built an end-to-end prototype automating this initial screening layer.
        </p>
      </div>
    </div>

    <!-- Bullet Points -->
    <div class="space-y-2 text-slate mb-5">
      <div class="flex gap-3">
        <span class="text-green mt-0.5">▹</span>
        <span class="text-sm">Accepts unstructured startup lead data as input</span>
      </div>
      <div class="flex gap-3">
        <span class="text-green mt-0.5">▹</span>
        <span class="text-sm">Runs regulatory compliance check against BaFin requirements</span>
      </div>
      <div class="flex gap-3">
        <span class="text-green mt-0.5">▹</span>
        <span class="text-sm">Benchmarks against database of 100+ stored companies</span>
      </div>
      <div class="flex gap-3">
        <span class="text-green mt-0.5">▹</span>
        <span class="text-sm">Auto-generates scoring dashboard with investment recommendation</span>
      </div>
    </div>

    <!-- Tech Stack Tags -->
    <div class="flex flex-wrap gap-2 mb-6">
      <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">n8n</span>
      <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Open-source LLM</span>
      <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Render</span>
      <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">NeonDB</span>
      <span class="px-3 py-1 bg-navy text-green text-xs font-mono rounded border border-green/30">Antigravity</span>
    </div>

    <!-- Link -->
    <div class="flex flex-wrap gap-4">
      <a
        href={withBase('projects/fintech-qualifier/')}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 border border-green text-green font-mono text-sm rounded hover:bg-green/10 transition-all duration-300"
      >
        View Live Project ↗
      </a>
    </div>
  </div>

  <!-- Note below project -->
  <p class="text-slate text-sm leading-relaxed mt-6 max-w-2xl opacity-75">
    Working prototype, not a polished product.
  </p>

</section>
